# =============================================================================
# 部署配置 —— 整个项目**唯一**需要改的文件
#
#   cp config.env.example config.env   # 然后按需修改（不要提交这个文件）
#
# 改完：bash scripts/ops.sh doctor    # 体检
#
# ⚠️ 这里只放**占位符** —— 真实值（账号 id / 库 id / 域名 / 凭据）不要进版本库。
#    每个值怎么拿，写在对应行的注释里。
# =============================================================================

# ───────────────────────── 站点 ─────────────────────────
SITE_URL="https://example.com"

# ───────────────────────── 部署目标（Cloudflare Workers）─────────────────────────
WORKER_NAME="ourteam"
D1_DATABASE_NAME="ourteam-content"
D1_DATABASE_ID=""
R2_BUCKET_NAME="ourteam-media"
CLOUDFLARE_ACCOUNT_ID=""
# 唯一的账户级 Token（Manage Account → Account API Tokens），部署 / D1 / R2 / secrets 共用
# 不需要用户级 Token；构建配置在 Dashboard 一次性完成（详见 README「后台触发构建」）
# 不要上传到 Worker，也不要提交
CLOUDFLARE_API_TOKEN=""
# 在 Dashboard → Worker → Settings → Builds 创建 Deploy Hook 后填入（不要提交）
DEPLOY_HOOK_URL=""

# ───────────────────────── 后台凭据 ─────────────────────────
# 后台口令的 SHA-256（十六进制）。改口令：
#   printf '%s' '你的口令' | shasum -a 256 | cut -d' ' -f1
ADMIN_PASSWORD_HASH=""
# 会话签名密钥（随机长串：openssl rand -hex 32）
SESSION_SECRET=""
