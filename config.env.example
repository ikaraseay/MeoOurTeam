# =============================================================================
# 部署配置模板
#
#   cp config.env.example config.env
#
# 下面全部是占位符，请按注释换成你自己的值；照抄会指向不存在的资源。
# config.env 已被 .gitignore 忽略，不要提交，真实值只留在本地。
#
# 填完跑 bash scripts/ops.sh doctor 体检。
# =============================================================================

# ───────────────────────── 站点 ─────────────────────────
# 对外访问地址：只写 origin，不带路径，结尾不加斜杠
SITE_URL="https://your-domain.com"

# ───────────────────────── 部署目标（Cloudflare Workers）─────────────────────────
# Worker 名称（会同步进 wrangler.jsonc 的 name）
WORKER_NAME="your-worker-name"
# D1 数据库名与 id：pnpm wrangler d1 create <数据库名> 的输出
D1_DATABASE_NAME="your-d1-database"
D1_DATABASE_ID=""
# R2 桶名：pnpm wrangler r2 bucket create <桶名>
R2_BUCKET_NAME="your-r2-bucket"
# 账户 id：wrangler whoami 或 Dashboard 右侧 Account ID
CLOUDFLARE_ACCOUNT_ID=""
# 唯一的账户级 Token（Manage Account → Account API Tokens），部署 / D1 / R2 / secrets 共用；
# 不需要用户级 Token。不要上传到 Worker，也不要提交。
CLOUDFLARE_API_TOKEN=""
# 后台「立即构建」用的 Deploy Hook：Dashboard → Worker → Settings → Builds 创建后复制
DEPLOY_HOOK_URL=""

# ───────────────────────── 后台凭据 ─────────────────────────
# 后台口令的 SHA-256（十六进制）。改口令：
#   printf '%s' '你的口令' | shasum -a 256 | cut -d' ' -f1
ADMIN_PASSWORD_HASH=""
# 会话签名密钥：openssl rand -hex 32
SESSION_SECRET=""
