# =============================================================================
# 部署配置 —— 整个项目**唯一**需要改的文件
#
#   cp config.env.example config.env   # 然后按需修改（不要提交这个文件）
#
# 改完：bash scripts/ops.sh doctor    # 体检
#
# ⚠️ 这里只放**占位符** —— 真实值（账号 id / 库 id / 域名 / 凭据）不要进版本库。
#    每个值怎么拿，写在对应行的注释里。
# =============================================================================

# ───────────────────────── 站点 ─────────────────────────
SITE_URL="https://example.com"

# ───────────────────────── 部署目标（Cloudflare Workers）─────────────────────────
WORKER_NAME="ourteam"
D1_DATABASE_NAME="ourteam-content"
D1_DATABASE_ID=""
R2_BUCKET_NAME="ourteam-media"
CLOUDFLARE_ACCOUNT_ID=""

# ───────────────────────── 后台凭据 ─────────────────────────
# 后台口令的 SHA-256（十六进制）。改口令：
#   printf '%s' '你的口令' | shasum -a 256 | cut -d' ' -f1
ADMIN_PASSWORD_HASH=""
# 会话签名密钥（随机长串：openssl rand -hex 32）
SESSION_SECRET=""
