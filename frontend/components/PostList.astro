---
import { newsCategoryIds } from "../lib/news";
import Text from "./Text.astro";

import type { BlogPost } from "../lib/posts";
import { tagHref } from "../lib/posts";
import { formatDate } from "../lib/format";

interface Props { posts: BlogPost[]; filterable?: boolean }
const { posts, filterable = false } = Astro.props;
---

{posts.length === 0 ? (
  <p class="text-center py-12 text-sm md:text-base text-fg-muted"><Text k="latestposts.text005" /></p>
) : (
  <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
    {posts.map((post) => (
      <li data-catalog-item={filterable || undefined} data-search={filterable ? `${post.data.title} ${post.data.description} ${post.data.tags.join(" ")}` : undefined} data-categories={filterable ? newsCategoryIds(post.data.tags).join(" ") : undefined} data-reveal class="surface feature-card p-6 md:p-7">
        <div class="flex items-center gap-2 flex-wrap">
          {post.data.tags.map((tag) => (
            <a href={tagHref(tag)} class="font-mono text-xs text-accent hover:underline">#{tag}</a>
          ))}
        </div>
        <h2 class="font-bold tracking-tight text-lg md:text-xl mt-3 text-fg">
          <a href={`/blog/${post.id}/`} class="hover:underline">{post.data.title}</a>
        </h2>
        <p class="text-xs md:text-sm mt-2 leading-relaxed line-clamp-3 text-fg-muted">{post.data.description}</p>
        <div class="mt-4 flex items-center justify-between text-xs text-fg-subtle">
          <time datetime={post.data.pubDate.toISOString()}><Text value={formatDate(post.data.pubDate)} /></time>
          <a href={`/blog/${post.id}/`} class="font-medium text-accent hover:underline"><Text k="latestposts.text006" /></a>
        </div>
      </li>
    ))}
  </ul>
)}
