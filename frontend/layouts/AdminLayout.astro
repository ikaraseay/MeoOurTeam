---
export const prerender = false

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | 管理后台</title>
    <link rel="stylesheet" href="/admin.css" />
    <style>
      :root {
        --bg: #ffffff;
        --bg-elev: #f8f9fa;
        --fg: #1a1a1a;
        --fg-muted: #666666;
        --fg-subtle: #999999;
        --border: #e0e0e0;
        --border-strong: #d0d0d0;
        --accent: #0066cc;
        --accent-fg: #ffffff;
        --accent-soft: rgba(0, 102, 204, 0.1);
        --shadow-lg: 0 10px 25px rgba(0,0,0,0.1);
        --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1a1a1a;
          --bg-elev: #2a2a2a;
          --fg: #ffffff;
          --fg-muted: #aaaaaa;
          --fg-subtle: #888888;
          --border: #3a3a3a;
          --border-strong: #4a4a4a;
          --accent: #4d9fff;
          --accent-fg: #000000;
          --accent-soft: rgba(77, 159, 255, 0.15);
        }
      }

      * { box-sizing: border-box; }
      html, body { min-height: 100%; }
      body { margin: 0; background: var(--bg-elev); color: var(--fg); font-family: var(--font-sans); line-height: 1.6; }
      
      button, input, textarea, select { font: inherit; }
      button, .upload-button { cursor: pointer; }
      
      button { 
        border: 1px solid var(--accent); 
        border-radius: .65rem; 
        background: var(--accent); 
        color: var(--accent-fg); 
        padding: .65rem 1rem; 
        font-size: .9rem; 
        font-weight: 650; 
        transition: opacity .15s, background-color .15s; 
      }
      button:hover { opacity: .82; }
      button:disabled { cursor: wait; opacity: .5; }
      
      input, textarea, select { 
        width: 100%; 
        border: 1px solid var(--border-strong); 
        border-radius: .65rem; 
        padding: .75rem .9rem; 
        background: var(--bg); 
        color: var(--fg); 
        outline: none; 
      }
      input:focus, textarea:focus, select:focus { 
        border-color: var(--accent); 
        box-shadow: 0 0 0 3px var(--accent-soft); 
      }
      textarea { resize: vertical; line-height: 1.65; min-height: 100px; }
      
      label { display: block; font-size: .88rem; font-weight: 650; margin: 1.25rem 0 .5rem; }
      small, .muted, .field-help { color: var(--fg-muted); }
      .field-help { font-size: .78rem; line-height: 1.5; margin: .5rem 0 1rem; }
      
      .eyebrow { color: var(--accent); font-size: .7rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
      
      .login-shell { min-height: 100vh; display: grid; place-items: center; padding: 1.25rem; }
      .login-card { width: min(100%, 420px); padding: 2.25rem; border: 1px solid var(--border); border-radius: 1.1rem; background: var(--bg); box-shadow: var(--shadow-lg); }
      .login-card h1 { margin: .8rem 0 .25rem; font-size: 1.7rem; letter-spacing: -.03em; }
      .login-card form { margin-top: 2rem; }
      .login-card button { width: 100%; margin-top: 1.2rem; }
      #login-message { color: var(--accent); min-height: 1.5rem; font-size: .85rem; }
      
      .app-shell { min-height: 100vh; display: grid; grid-template-columns: 240px minmax(0, 1fr); }
      .sidebar { 
        min-width: 0; 
        position: sticky; 
        top: 0; 
        height: 100vh; 
        padding: 2rem 1.1rem 1rem; 
        border-right: 1px solid var(--border); 
        background: var(--bg); 
        display: flex; 
        flex-direction: column; 
      }
      .brand { display: block; margin: .1rem .9rem 2.5rem; font-size: 1.05rem; font-weight: 750; text-decoration: none; color: var(--fg); }
      .brand small { display: block; margin-top: .3rem; font-size: .72rem; font-weight: 500; }
      .sidebar nav { display: grid; gap: .25rem; }
      .sidebar nav button, .sidebar nav a, .logout { 
        display: block; 
        width: 100%; 
        text-align: left; 
        padding: .7rem .9rem; 
        border: 0; 
        border-radius: .6rem; 
        color: var(--fg-muted); 
        background: transparent; 
        font-size: .9rem; 
        font-weight: 550; 
        text-decoration: none; 
        transition: background .15s;
      }
      .sidebar nav button:hover, .sidebar nav a:hover { background: var(--bg-elev); }
      .sidebar nav .nav-active, .sidebar nav a.active { background: var(--accent-soft); color: var(--accent); }
      .logout { margin-top: auto; }
      
      .workspace { min-width: 0; width: min(100%, 1300px); padding: 2.5rem clamp(1rem, 4vw, 4rem) 5rem; }
      .workspace-header { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.75rem; }
      .workspace-header h1 { margin: .35rem 0 0; font-size: clamp(1.65rem, 3vw, 2.4rem); letter-spacing: -.04em; }
      .workspace-header .eyebrow { margin: 0; }
      
      #notice { min-height: 1.4rem; font-size: .85rem; color: var(--accent); margin-bottom: 1rem; }
      
      .toolbar { display: flex; gap: .75rem; margin-bottom: 1rem; }
      .toolbar input { max-width: 460px; }
      .toolbar select { max-width: 180px; }
      
      .list-panel { border: 1px solid var(--border); border-radius: .85rem; background: var(--bg); overflow: hidden; }
      .post-row { 
        padding: 1.15rem 1.4rem; 
        border-bottom: 1px solid var(--border); 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        gap: 1rem; 
      }
      .post-row:last-child { border-bottom: 0; }
      .post-row button { text-align: left; border: 0; padding: 0; color: var(--fg); background: transparent; font-size: 1rem; font-weight: 650; }
      .post-row p { margin: .35rem 0 0; color: var(--fg-muted); font-size: .8rem; }
      
      .status { display: inline-flex; align-items: center; border: 1px solid var(--border); border-radius: 99px; color: var(--fg-muted); padding: .25rem .6rem; font-size: .73rem; white-space: nowrap; }
      .status.published { color: var(--accent); border-color: var(--accent); }
      
      .empty-state { padding: 3rem 1.5rem; color: var(--fg-muted); text-align: center; }
      
      .editor-actions { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; margin-bottom: 1.2rem; }
      .action-spacer { flex: 1; }
      .secondary { border-color: var(--border-strong); background: var(--bg); color: var(--fg); }
      .danger-outline { border-color: var(--border-strong); background: var(--bg); color: var(--fg-muted); }
      .danger-outline:hover { color: var(--fg); border-color: var(--fg-muted); }
      
      .card { 
        background: var(--bg); 
        border: 1px solid var(--border); 
        border-radius: .9rem; 
        padding: 1.5rem; 
        margin-bottom: 1rem; 
      }
      .card h3 { margin: 0 0 1rem; font-size: 1.15rem; }
      
      .stats-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); 
        gap: 1rem; 
        margin-bottom: 2rem; 
      }
      .stat-card { 
        background: var(--bg); 
        border: 1px solid var(--border); 
        border-radius: .95rem; 
        padding: 1.5rem; 
      }
      .stat-value { font-size: 2rem; font-weight: 700; color: var(--accent); }
      .stat-label { color: var(--fg-muted); font-size: .875rem; margin-top: .25rem; }
      
      table { width: 100%; border-collapse: collapse; background: var(--bg); border-radius: .85rem; overflow: hidden; }
      th, td { padding: .75rem 1rem; text-align: left; border-bottom: 1px solid var(--border); }
      th { background: var(--bg-elev); font-weight: 600; font-size: .875rem; }
      tr:last-child td { border-bottom: none; }
      tr:hover { background: var(--bg-elev); }
      
      .actions { display: flex; gap: .5rem; }
      .actions button { padding: .4rem .8rem; font-size: .8rem; }
      
      .alert { padding: 1rem; border-radius: .65rem; margin-bottom: 1rem; }
      .alert-success { background: rgba(40, 167, 69, 0.1); color: #28a745; border: 1px solid rgba(40, 167, 69, 0.2); }
      .alert-error { background: rgba(220, 53, 69, 0.1); color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.2); }
      
      .badge { padding: .25rem .6rem; border-radius: 99px; font-size: .73rem; font-weight: 600; }
      .badge-success { background: rgba(40, 167, 69, 0.15); color: #28a745; }
      .badge-warning { background: rgba(255, 193, 7, 0.15); color: #ffc107; }
      .badge-error { background: rgba(220, 53, 69, 0.15); color: #dc3545; }
      
      .form-group { margin-bottom: 1rem; }
      .form-group label { margin-bottom: .5rem; }
      .form-control { width: 100%; }
      
      .modal { 
        position: fixed; 
        top: 0; 
        left: 0; 
        right: 0; 
        bottom: 0; 
        background: rgba(0,0,0,0.5); 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        z-index: 1000; 
      }
      .modal-content { 
        background: var(--bg); 
        padding: 2rem; 
        border-radius: .95rem; 
        max-width: 500px; 
        width: 90%; 
        max-height: 90vh;
        overflow-y: auto;
      }
      .modal-content h3 { margin: 0 0 1.5rem; }
      
      .media-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); 
        gap: 1rem; 
        margin-top: 1.5rem; 
      }
      .media-item { 
        border: 1px solid var(--border); 
        border-radius: .8rem; 
        background: var(--bg); 
        overflow: hidden; 
        padding: 1rem;
      }
      .media-item img { 
        width: 100%; 
        height: 150px; 
        object-fit: cover; 
        border-radius: .65rem; 
        margin-bottom: .75rem;
      }
      
      @media (max-width: 900px) { 
        .app-shell { grid-template-columns: minmax(0, 1fr); } 
        .sidebar { position: static; height: auto; padding: .8rem 1rem; flex-direction: row; align-items: center; gap: 1rem; border-right: 0; border-bottom: 1px solid var(--border); } 
        .brand { margin: 0; white-space: nowrap; } 
        .brand small { display: none; } 
        .sidebar nav { display: flex; gap: .2rem; overflow-x: auto; } 
        .sidebar nav button, .sidebar nav a { width: auto; white-space: nowrap; padding: .5rem; } 
        .logout { width: auto; margin: 0 0 0 auto; white-space: nowrap; } 
        .workspace { padding: 1.5rem 1rem 4rem; } 
      }
      
      .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
      .page-header h2 { margin: 0; font-size: 1.5rem; }
      
      .btn { display: inline-flex; align-items: center; justify-content: center; padding: .65rem 1rem; border-radius: .65rem; font-size: .9rem; font-weight: 600; text-decoration: none; transition: opacity .15s; cursor: pointer; }
      .btn-primary { background: var(--accent); color: var(--accent-fg); border: 1px solid var(--accent); }
      .btn-primary:hover { opacity: .85; }
      .btn-secondary { background: var(--bg); color: var(--fg); border: 1px solid var(--border-strong); }
      .btn-secondary:hover { border-color: var(--fg-muted); }
      
      @media (max-width: 700px) { 
        .toolbar { flex-direction: column; } 
        .toolbar input, .toolbar select { max-width: none; } 
        .workspace-header { align-items: center; } 
        .page-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
      }
    </style>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="brand" href="/admin">
          管理后台
          <small>内容管理系统</small>
        </a>
        <nav aria-label="主导航">
          <a href="/admin" class:list={{ active: Astro.url.pathname === '/admin' }}>仪表盘</a>
          <a href="/admin/members" class:list={{ active: Astro.url.pathname.startsWith('/admin/members') }}>成员管理</a>
          <a href="/admin/research" class:list={{ active: Astro.url.pathname.startsWith('/admin/research') }}>研究方向</a>
          <a href="/admin/projects" class:list={{ active: Astro.url.pathname.startsWith('/admin/projects') }}>项目管理</a>
          <a href="/admin/outcomes" class:list={{ active: Astro.url.pathname.startsWith('/admin/outcomes') }}>成果管理</a>
          <a href="/admin/news" class:list={{ active: Astro.url.pathname.startsWith('/admin/news') }}>新闻管理</a>
          <a href="/admin/media" class:list={{ active: Astro.url.pathname.startsWith('/admin/media') }}>媒体库</a>
          <a href="/admin?view=texts" class:list={{ active: Astro.url.pathname.startsWith('/admin/texts') }}>文案管理</a>
          <a href="/admin?view=releases" class:list={{ active: Astro.url.pathname.startsWith('/admin/releases') }}>发布管理</a>
          <a href="/admin/settings" class:list={{ active: Astro.url.pathname.startsWith('/admin/settings') }}>系统设置</a>
          <a href="/" target="_blank" rel="noopener noreferrer">查看网站</a>
        </nav>
        <button id="logout-btn" class="logout" type="button">退出登录</button>
      </aside>
      <main class="workspace">
        <slot />
      </main>
    </div>
    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/admin/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      });
    </script>
  </body>
</html>
