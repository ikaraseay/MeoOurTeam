---
export const prerender = false

import AdminLayout from '../../../layouts/AdminLayout.astro'

const response = await fetch(`${Astro.url.origin}/api/admin/news`, {
  headers: { cookie: Astro.request.headers.get('cookie') || '' },
})

let items = []
if (response.ok) {
  const data = await response.json()
  items = data.news || []
}
---

<AdminLayout title="新闻管理">
  <div class="page-header">
    <h2>新闻管理</h2>
    <a href="/admin/news/new" class="btn btn-primary">发布新闻</a>
  </div>

  <table>
    <thead>
      <tr>
        <th>标题</th>
        <th>分类</th>
        <th>发布日期</th>
        <th>状态</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      {items.map((item) => (
        <tr>
          <td>{item.title}</td>
          <td>{item.category}</td>
          <td>{item.pub_date || '-'}</td>
          <td>
            <span class:list={{ 'badge': true, 'badge-success': item.status === 'published', 'badge-warning': item.status === 'draft' }}>
              {item.status === 'published' ? '已发布' : '草稿'}
            </span>
          </td>
          <td class="actions">
            <a href={`/admin/news/${item.id}`} class="btn btn-secondary">编辑</a>
            <button class="btn btn-danger" data-id={item.id} onclick="deleteItem(this)">删除</button>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  {items.length === 0 && (
    <div class="card" style="text-align: center; color: var(--muted);">
      暂无新闻
    </div>
  )}

  <style>
    .badge { padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 500; }
    .badge-success { background: #d4edda; color: #155724; }
    .badge-warning { background: #fff3cd; color: #856404; }
  </style>

  <script>
    async function deleteItem(btn) {
      if (!confirm('确定要删除吗？')) return;
      const id = btn.dataset.id;
      const res = await fetch(`/api/admin/news/${id}`, { method: 'DELETE' });
      if (res.ok) {
        btn.closest('tr').remove();
      } else {
        alert('删除失败');
      }
    }
    window.deleteItem = deleteItem;
  </script>
</AdminLayout>
