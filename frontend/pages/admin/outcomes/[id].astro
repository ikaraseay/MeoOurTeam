---
export const prerender = false

import AdminLayout from '../../../layouts/AdminLayout.astro'

const itemId = Astro.params.id
const isNew = !itemId || itemId === 'new'

let item = {
  id: '',
  title: '',
  type: 'paper',
  description: '',
  url: '',
  pdf_key: '',
  date: '',
  authors: '[]',
  tags: '[]',
  sort_order: 0,
  is_active: true,
}

if (!isNew) {
  const response = await fetch(`${Astro.url.origin}/api/admin/outcomes`, {
    headers: { cookie: Astro.request.headers.get('cookie') || '' },
  })
  if (response.ok) {
    const data = await response.json() as { outcomes?: Array<typeof item> }
    item = (data.outcomes || []).find((o) => o.id === itemId) || item
  }
}
---

<AdminLayout title={isNew ? '添加成果' : '编辑成果'}>
  <div class="page-header">
    <h2>{isNew ? '添加成果' : '编辑成果'}</h2>
    <a href="/admin/outcomes" class="btn btn-secondary">返回列表</a>
  </div>

  <div class="card">
    <form id="form" data-item-id={itemId} data-is-new={String(isNew)}>
      <div class="form-group">
        <label for="title">标题 *</label>
        <input type="text" id="title" name="title" class="form-control" value={item.title} required />
      </div>

      <div class="form-group">
        <label for="type">类型</label>
        <select id="type" name="type" class="form-control">
          <option value="paper" selected={item.type === 'paper'}>论文</option>
          <option value="patent" selected={item.type === 'patent'}>专利</option>
          <option value="award" selected={item.type === 'award'}>奖项</option>
          <option value="project" selected={item.type === 'project'}>项目</option>
          <option value="other" selected={item.type === 'other'}>其他</option>
        </select>
      </div>

      <div class="form-group">
        <label for="description">描述</label>
        <textarea id="description" name="description" class="form-control">{item.description}</textarea>
      </div>

      <div class="form-group">
        <label for="url">链接</label>
        <input type="url" id="url" name="url" class="form-control" value={item.url} placeholder="https://" />
      </div>

      <div class="form-group">
        <label for="pdf_key">PDF 路径</label>
        <input type="text" id="pdf_key" name="pdf_key" class="form-control" value={item.pdf_key} placeholder="/path/to/file.pdf" />
      </div>

      <div class="form-group">
        <label for="date">日期</label>
        <input type="date" id="date" name="date" class="form-control" value={item.date || ''} />
      </div>

      <div class="form-group">
        <label for="authors">作者 (JSON 数组)</label>
        <input type="text" id="authors" name="authors" class="form-control" value={item.authors} placeholder='["张三", "李四"]' />
      </div>

      <div class="form-group">
        <label for="tags">标签 (JSON 数组)</label>
        <input type="text" id="tags" name="tags" class="form-control" value={item.tags} placeholder='["AI", "robotics"]' />
      </div>

      <div class="form-group">
        <label for="sort_order">排序</label>
        <input type="number" id="sort_order" name="sort_order" class="form-control" value={item.sort_order} />
      </div>

      <div class="form-group">
        <label>
          <input type="checkbox" id="is_active" name="is_active" checked={item.is_active} />
          活跃状态
        </label>
      </div>

      <div style="display: flex; gap: 0.5rem;">
        <button type="submit" class="btn btn-primary">保存</button>
        <a href="/admin/outcomes" class="btn btn-secondary">取消</a>
      </div>

      <div id="result" class="alert" style="display: none; margin-top: 1rem;"></div>
    </form>
  </div>

  <script>
    const formEl = document.getElementById('form') as HTMLFormElement | null;
    const itemId = formEl?.dataset.itemId || '';
    const isNew = formEl?.dataset.isNew === 'true';

    formEl?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as unknown as Record<string, HTMLInputElement>;
      const data = {
        title: form.title.value,
        type: form.type.value,
        description: form.description.value,
        url: form.url.value,
        pdf_key: form.pdf_key.value,
        date: form.date.value || null,
        authors: form.authors.value,
        tags: form.tags.value,
        sort_order: parseInt(form.sort_order.value) || 0,
        is_active: form.is_active.checked,
      };

      const url = isNew ? '/api/admin/outcomes' : `/api/admin/outcomes/${itemId}`;
      const method = isNew ? 'POST' : 'PUT';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const resultEl = document.getElementById('result') as HTMLElement;
      resultEl.style.display = 'block';

      if (res.ok) {
        resultEl.className = 'alert alert-success';
        resultEl.textContent = '保存成功！';
        setTimeout(() => window.location.href = '/admin/outcomes', 1000);
      } else {
        const err = await res.json() as { error?: string };
        resultEl.className = 'alert alert-error';
        resultEl.textContent = `保存失败: ${err.error}`;
      }
    });
  </script>
</AdminLayout>
