---
export const prerender = false

import AdminLayout from '../../../layouts/AdminLayout.astro'

const response = await fetch(`${Astro.url.origin}/api/admin/projects`, {
  headers: { cookie: Astro.request.headers.get('cookie') || '' },
})

interface ProjectItem {
  id: string
  name: string
  category: string
  url: string
  is_active: boolean | number
}

let items: ProjectItem[] = []
if (response.ok) {
  const data = await response.json() as { projects?: ProjectItem[] }
  items = data.projects || []
}
---

<AdminLayout title="项目管理">
  <div class="page-header">
    <h2>项目管理</h2>
    <a href="/admin/projects/new" class="btn btn-primary">添加项目</a>
  </div>

  <table>
    <thead>
      <tr>
        <th>名称</th>
        <th>分类</th>
        <th>链接</th>
        <th>状态</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      {items.map((item) => (
        <tr>
          <td>{item.name}</td>
          <td>{item.category}</td>
          <td><a href={item.url} target="_blank" rel="noopener">{item.url ? '查看' : '-'}</a></td>
          <td>{item.is_active ? '活跃' : '隐藏'}</td>
          <td class="actions">
            <a href={`/admin/projects/${item.id}`} class="btn btn-secondary">编辑</a>
            <button class="btn btn-danger" data-id={item.id} onclick="deleteItem(this)">删除</button>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  {items.length === 0 && (
    <div class="card" style="text-align: center; color: var(--muted);">
      暂无项目
    </div>
  )}

  <script>
    async function deleteItem(btn: HTMLElement) {
      if (!confirm('确定要删除吗？')) return;
      const id = btn.dataset.id;
      const res = await fetch(`/api/admin/projects/${id}`, { method: 'DELETE' });
      if (res.ok) {
        btn.closest('tr')?.remove();
      } else {
        alert('删除失败');
      }
    }
    (window as unknown as Record<string, unknown>).deleteItem = deleteItem;
  </script>
</AdminLayout>
