---
import { t, defaults } from "../lib/text-config";
import Text from "../components/Text.astro";

import ResourceCatalog from "../components/ResourceCatalog.astro";
import PageFrame from "../components/PageFrame.astro";
import PostList from "../components/PostList.astro";
import { getPublishedPosts } from "../lib/posts";

const uploadedOutcomes = (await getPublishedPosts()).filter((post) => post.data.tags.includes(defaults["outcomes.title001"]));
---

<PageFrame
  title={t("outcomes.title001")}
  eyebrow={t("outcomes.eyebrow002")}
  description={t("outcomes.description003")}
  canonicalPath="/outcomes/"
>
  <section class="px-4 md:px-8 section-space bg-base">
    <div class="max-w-6xl mx-auto">
      <div class="mb-6">
        <p class="font-mono text-xs text-accent"><Text k="resources.eyebrow" /></p>
        <h2 class="mt-3 section-title font-bold text-fg"><Text k="resources.title" /></h2>
        <p class="mt-3 text-sm leading-relaxed text-fg-muted"><Text k="resources.description" /></p>
      </div>
      <ResourceCatalog />

      {uploadedOutcomes.length > 0 && <section class="mt-16">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="font-mono text-xs text-accent"><Text k="outcomes.text009" /></p>
            <h2 class="mt-3 font-bold tracking-tight text-2xl md:text-3xl text-fg"><Text k="outcomes.text010" /></h2>
          </div>
        </div>
        <div class="mt-8">
          <PostList posts={uploadedOutcomes} />
        </div>
      </section>}
    </div>
  </section>

</PageFrame>
